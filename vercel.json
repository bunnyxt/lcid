{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "outputDirectory": "build",
  "headers": [
    {
      "source": "/info",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET, HEAD, OPTIONS" },
        { "key": "Access-Control-Allow-Headers", "value": "*" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/info", "destination": "/info.json" },
    { "source": "/info/:problem_id", "destination": "/api/problem?problem_id=:problem_id&mode=info" },
    { "source": "/cn/:problem_id", "destination": "/api/problem?problem_id=:problem_id&mode=cn" },
    { "source": "/:problem_id", "destination": "/api/problem?problem_id=:problem_id" }
  ]
}
